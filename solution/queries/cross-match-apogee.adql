SELECT TOP 100
    g.source_id,
    g.ra,
    g.dec,
    g.phot_bp_mean_mag,
    g.phot_rp_mean_mag,
    g.has_xp_continuous,
    s.original_ext_source_id AS sdss_id,
    s.angular_distance
FROM gaiadr3.gaia_source AS g
JOIN gaiadr3.sdssdr13_best_neighbour AS s
  ON g.source_id = s.source_id
WHERE g.has_xp_continuous = 'True'
AND s.angular_distance < 0.02