SELECT 
    gaia.source_id, 
    gaia.ra, 
    gaia.dec, 
    gaia.phot_g_mean_mag,
    apogee.teff AS apogee_teff, 
    apogee.logg AS apogee_logg, 
    apogee.fe_h AS apogee_metallicity
FROM gaiadr3.gaia_source AS gaia
JOIN external.apogee_dr17 AS apogee
  ON 1=CONTAINS(
    POINT('ICRS', gaia.ra, gaia.dec),
    CIRCLE('ICRS', apogee.ra, apogee.dec, 0.00027) 
  )
WHERE gaia.has_xp_continuous = 'True' 
  AND apogee.teff IS NOT NULL