# %ECSV 1.0
# ---
# datatype:
# - name: source_id
#   datatype: int64
#   description: Unique source identifier (unique within a particular Data Release)
#   meta: !!omap
#   - {ucd: meta.id}
# - name: ra
#   unit: deg
#   datatype: float64
#   description: Right ascension
#   meta: !!omap
#   - {ucd: pos.eq.ra;meta.main}
#   - {utype: 'stc:AstroCoords.Position3D.Value3.C1'}
# - name: dec
#   unit: deg
#   datatype: float64
#   description: Declination
#   meta: !!omap
#   - {ucd: pos.eq.dec;meta.main}
#   - {utype: 'stc:AstroCoords.Position3D.Value3.C2'}
# - name: phot_bp_mean_mag
#   unit: mag
#   datatype: float32
#   description: Integrated BP mean magnitude
#   meta: !!omap
#   - {ucd: phot.mag;em.opt.B}
# - name: phot_rp_mean_mag
#   unit: mag
#   datatype: float32
#   description: Integrated RP mean magnitude
#   meta: !!omap
#   - {ucd: phot.mag;em.opt.R}
# - name: phot_bp_mean_flux_over_error
#   datatype: float32
#   description: Integrated BP mean flux divided by its error
#   meta: !!omap
#   - {ucd: stat.snr;phot.flux;em.opt.B}
# - name: phot_rp_mean_flux_over_error
#   datatype: float32
#   description: Integrated RP mean flux divided by its error
#   meta: !!omap
#   - {ucd: stat.snr;phot.flux;em.opt.R}
# - name: astrometric_excess_noise
#   unit: mas
#   datatype: float32
#   description: Excess noise of the source
#   meta: !!omap
#   - {ucd: stat.value}
# - name: bp_rp
#   unit: mag
#   datatype: float32
#   description: BP - RP colour
#   meta: !!omap
#   - {ucd: phot.color;em.opt.B;em.opt.R}
# - name: teff_gspphot
#   unit: K
#   datatype: float32
#   description: Effective temperature from GSP-Phot Aeneas best library using BP/RP spectra
#   meta: !!omap
#   - {ucd: phys.temperature.effective}
# - name: logg_gspphot
#   unit: log(cm.s**-2)
#   datatype: float32
#   description: Surface gravity from GSP-Phot Aeneas best library using BP/RP spectra
#   meta: !!omap
#   - {ucd: phys.gravity}
# - name: mh_gspphot
#   unit: dex
#   datatype: float32
#   description: Iron abundance from GSP-Phot Aeneas best library using BP/RP spectra
#   meta: !!omap
#   - {ucd: phys.abund.Z}
# - name: vbroad
#   unit: km / s
#   datatype: float32
#   description: Spectral line broadening parameter
#   meta: !!omap
#   - {ucd: spect.dopplerVeloc.opt;em.opt.I}
#   - {utype: 'stc:AstroCoords.Velocity3D.Value3.C3'}
# - name: alphafe_gspspec
#   unit: dex
#   datatype: float32
#   description: Abundance of alpha-elements [alpha/Fe] with respect to iron from GSP-Spec MatisseGauguin using RVS spectra and Monte
#     Carlo realisations
#   meta: !!omap
#   - {ucd: phys.abund;stat.median}
# - name: original_ext_source_id
#   datatype: int64
#   description: Original External Catalogue source identifier
#   meta: !!omap
#   - {ucd: meta.id.cross}
# - name: angular_distance
#   unit: arcsec
#   datatype: float32
#   description: Angular Distance between the two sources
#   meta: !!omap
#   - {ucd: pos.angDistance}
# - {name: plate, datatype: int32}
# - {name: mjd, datatype: int32}
# - {name: fiberID, datatype: int32}
# - {name: redshift, datatype: float32}
# schema: astropy-2.0
