SELECT
  gaia.source_id
  ,gaia.ra
  ,gaia.dec
  ,gaia.phot_bp_mean_mag
  ,gaia.phot_rp_mean_mag

  -- Razón Señal a Ruido BP/RP (flux/flux_error, proxy for SNR in BP and RP spectra)
  ,gaia.phot_bp_mean_flux_over_error
  ,gaia.phot_rp_mean_flux_over_error

  -- Ruido
  ,gaia.astrometric_excess_noise

  -- Color
  ,gaia.bp_rp

  -- Temperatura -Effective temperature from GSP-Phot Aeneas best library using BP/RP spectra (float, Temperature[K])
  ,gaia.teff_gspphot

  -- Gravedad -Surface gravity from GSP-Phot Aeneas best library using BP/RP spectra (float, GravitySurface[log cgs])
  ,gaia.logg_gspphot

  --Metalicidad (Iron abundance from GSP-Phot Aeneas best library using BP/RP spectra)
  ,gaia.mh_gspphot

  --Relacionado con la macroturbulencia
  ,gaia.vbroad

  --Alfa -Median abundance of alpha-elements with respect to iron (assuming source is a single star)Median abundance of alpha-elements with respect to iron (assuming source is a single star)
  ,ap.alphafe_gspspec 

  ,xmatch.original_ext_source_id
  ,xmatch.angular_distance
FROM
  gaiadr3.gaia_source AS gaia
  JOIN gaiadr3.astrophysical_parameters AS ap
  ON gaia.source_id = ap.source_id
  JOIN gaiadr3.sdssdr13_best_neighbour AS xmatch
  ON gaia.source_id = xmatch.source_id
WHERE
  1=1
  AND gaia.random_index BETWEEN {start_index} AND {end_index}
  AND ap.alphafe_gspspec IS NOT NULL
  AND gaia.teff_gspphot IS NOT NULL
  AND gaia.logg_gspphot IS NOT NULL
  AND gaia.mh_gspphot IS NOT NULL
  -- AND gaia.has_xp_continuous = 'true' -- Inluye sólo los que tengan datos de espectrometría.
  -- AND gaia.phot_bp_mean_mag IS NOT NULL
  -- AND xmatch.angular_distance <= 6
  